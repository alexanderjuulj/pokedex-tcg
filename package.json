{
  "name": "pokedex-tcg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm db:migrate && concurrently --kill-others --names api,web --prefix-colors blue,green \"pnpm dev:api\" \"vite\"",
    "dev:api": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:server": "esbuild server/index.ts db/cli.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist-server --entry-names=[name] --out-extension:.js=.mjs --log-level=warning",
    "deploy:server": "bash deploy/deploy.sh",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning db/cli.ts migrate",
    "db:seed": "tsx --disable-warning=ExperimentalWarning db/cli.ts seed",
    "db:reset": "tsx --disable-warning=ExperimentalWarning db/cli.ts reset",
    "db:new": "tsx --disable-warning=ExperimentalWarning db/cli.ts new",
    "db:backup": "tsx --disable-warning=ExperimentalWarning db/cli.ts backup",
    "db:types": "tsx --disable-warning=ExperimentalWarning db/cli.ts types",
    "auth:login": "tsx --disable-warning=ExperimentalWarning db/cli.ts login",
    "catalog:pull": "tsx --disable-warning=ExperimentalWarning db/cli.ts catalog",
    "pokemon:art": "node scripts/pull-artwork.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hono/node-server": "^1.19.5",
    "@tanstack/react-query": "^5.90.2",
    "hono": "^4.9.10",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "sass": "^1.103.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9"
  }
}
