# Fixed ports, so devices can bookmark the app. Copy to .env to override;
# vite.config.ts and server/ both read these.
WEB_PORT=5320
API_PORT=5321

# The app's login. Don't write these by hand: `pnpm auth:login .env` asks for
# a username and password and fills them in (the password only as a hash).
# AUTH_USER=
# AUTH_PASSWORD_HASH=
# AUTH_SECRET=

# Where `pnpm deploy:server` ships the app and `pnpm db:pull` copies the data
# from (deploy/README.md): the server's IP or host name, the site's address,
# and an SSH key if the server needs one.
# DEPLOY_HOST=
# DEPLOY_SITE=https://pokedex.example.com
# DEPLOY_SSH_KEY=~/.ssh/hetzner_deploy_key
